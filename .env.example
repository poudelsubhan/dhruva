# Dhruva configuration — copy to .env and fill in.
# .env is gitignored; never commit real credentials.
#
# Dhruva talks to any OpenAI-compatible endpoint: set OPENAI_BASE_URL to
# OpenRouter, a vendor's own /v1, a gateway, or a local server (Ollama, vLLM,
# LM Studio) and the same client code works unchanged.

# Which ModelProvider implementation to use.
DHRUVA_PROVIDER=openai_compat

# Base URL of the OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Credential for OPENAI_BASE_URL.
OPENAI_API_KEY=sk-or-v1-...

# OpenRouter credential, when the endpoint above is OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...
